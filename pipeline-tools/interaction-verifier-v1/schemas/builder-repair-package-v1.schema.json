{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webharbor.local/schemas/builder-repair-package-v1.schema.json",
  "title": "WebHarbor Builder immersive repair package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repair_package", "site", "status", "candidate_fingerprint", "failure_count", "group_count", "groups"],
  "properties": {
    "schema_version": {"const": 1},
    "repair_package": {"const": "webharbor-builder-repair-package-v1"},
    "site": {"type": "string", "minLength": 1},
    "status": {"enum": ["repair_required", "empty"]},
    "candidate_fingerprint": {"type": "object", "required": ["algorithm", "sha256"]},
    "failure_count": {"type": "integer", "minimum": 0},
    "group_count": {"type": "integer", "minimum": 0},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_family", "page_archetype", "control_type", "failure_codes", "items"],
        "properties": {
          "route_family": {"type": "string"},
          "page_archetype": {"type": "string"},
          "control_type": {"type": "string"},
          "failure_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "items": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
