{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webharbor.local/schemas/interaction-contract-v1.schema.json",
  "title": "WebHarbor immersive interaction contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "profile",
    "site",
    "viewport",
    "crawl",
    "namespaces",
    "route_inventory",
    "control_inventory",
    "route_graph",
    "critical_workflows"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "webharbor-immersive-interaction-contract-v1"},
    "profile": {"const": "immersive"},
    "site": {"type": "string", "minLength": 1},
    "tool": {"const": "webharbor-immersive-contract-normalizer-v1"},
    "status": {"const": "declared"},
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_fingerprint": {
      "type": "object",
      "required": ["algorithm", "sha256", "site_implementation", "source_contract_sha256", "code_inventory_sha256", "interaction_diff_sha256", "analyzer", "analyzer_implementation_sha256", "verifier"],
      "properties": {
        "algorithm": {"const": "webharbor-immersive-candidate-v2"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "site_implementation": {"type": "object"},
        "source_contract_sha256": {"$ref": "#/$defs/sha256"},
        "code_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "interaction_diff_sha256": {"$ref": "#/$defs/sha256"},
        "analyzer": {"const": "webharbor-immersive-code-analyzer-v1"},
        "analyzer_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "verifier": {"const": "webharbor-standalone-interaction-verifier-v1"}
      }
    },
    "minimum_body_chars": {"type": "integer", "minimum": 1},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_pages", "max_depth", "start_routes"],
      "properties": {
        "max_pages": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 0},
        "start_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "/"},
          "items": {"$ref": "#/$defs/routeKey"}
        }
      }
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_origin", "local_prefix", "provenance"],
        "properties": {
          "kind": {"enum": ["primary", "official_supplemental"]},
          "source_origin": {"type": "string", "format": "uri"},
          "local_prefix": {"$ref": "#/$defs/routeKey"},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "route_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/route"}
    },
    "control_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    },
    "route_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "control_id"],
        "properties": {
          "from": {"$ref": "#/$defs/routeKey"},
          "to": {"$ref": "#/$defs/routeKey"},
          "control_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "critical_workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "routes", "controls"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/routeKey"}},
          "controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "synthetic_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "page_archetype", "fields", "provenance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "page_archetype": {"type": "string", "minLength": 1},
          "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "derived_surface": {"type": "object"}
  },
  "$defs": {
    "routeKey": {"type": "string", "pattern": "^/[^#]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sources"],
      "properties": {
        "kind": {"enum": ["captured", "source_grounded_synthetic"]},
        "synthetic_basis": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "source_grounded_synthetic"}}},
        "then": {"required": ["synthetic_basis"]}
      }]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "min_chars": {"type": "integer", "minimum": 0},
        "expected_path": {"$ref": "#/$defs/routeKey"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "family", "archetype", "critical", "provenance", "minimum_fields"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/routeKey"},
        "family": {"type": "string", "minLength": 1},
        "archetype": {"enum": ["landing", "listing", "detail", "search_results", "form", "reader", "download", "dashboard", "documentation", "policy", "status", "modal_host"]},
        "critical": {"type": "boolean"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "alias_of": {"$ref": "#/$defs/routeKey"},
        "canonical_selector": {"type": "string", "minLength": 1},
        "minimum_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "context", "main", "return"],
          "properties": {
            "title": {"$ref": "#/$defs/field"},
            "context": {"$ref": "#/$defs/field"},
            "main": {"$ref": "#/$defs/field"},
            "return": {
              "allOf": [
                {"$ref": "#/$defs/field"},
                {"required": ["expected_path"]}
              ]
            }
          }
        }
      },
      "dependentRequired": {"alias_of": ["canonical_selector"]}
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_path", "selector", "accessible_name", "control_type", "critical", "outcome"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/routeKey"},
        "selector": {"type": "string", "minLength": 1},
        "identity_selector": {"type": "string", "minLength": 1},
        "runtime_selector": {"type": "string", "minLength": 1},
        "control_identity": {"type": "object"},
        "accessible_name": {"type": "string", "minLength": 1},
        "control_type": {"enum": ["link", "button", "card", "menu", "disclosure", "tab", "form", "search", "filter", "pagination", "popup", "download", "state_change", "mutation", "input"]},
        "critical": {"type": "boolean"},
        "reveal": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outcome": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["navigation", "popup", "state_change", "input_state", "download", "mutation"]},
            "expected_path": {"$ref": "#/$defs/routeKey"},
            "action": {"enum": ["click", "fill", "select", "check", "submit"]},
            "value": {},
            "submit_selector": {"type": "string", "minLength": 1},
            "filename_regex": {"type": "string"},
            "steps": {"type": "array", "items": {"type": "object"}},
            "assertions": {"type": "array", "items": {"type": "object"}},
            "sqlite": {"type": "object"},
            "reset_evidence": {"type": "object"}
          }
        }
      }
    }
  }
}
