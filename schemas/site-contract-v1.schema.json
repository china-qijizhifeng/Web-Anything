{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webanything.dev/schemas/site-contract-v1.schema.json",
  "title": "WebAnything Site Contract",
  "type": "object",
  "required": ["schema", "site", "profile", "viewport", "routes", "workflows", "release_gates"],
  "properties": {
    "schema": {"const": "webanything-site-contract-v1"},
    "site": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "profile": {"enum": ["task-driven", "immersive", "authenticated"]},
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 320}
      }
    },
    "routes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "workflows": {"type": "array", "items": {"type": "object"}},
    "interaction_contract": {"type": "object"},
    "discovery_snapshot_assertions": {"type": "array", "items": {"type": "object"}},
    "legacy_seed_regression_assertions": {"type": "array", "items": {"type": "object"}},
    "synthetic_content_policy": {"type": "object"},
    "release_gates": {"type": "object"}
  },
  "additionalProperties": true
}
