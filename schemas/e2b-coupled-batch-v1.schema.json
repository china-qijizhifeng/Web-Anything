{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webanything.local/schemas/e2b-coupled-batch-v1.schema.json",
  "title": "WebAnything E2B coupled batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template", "workers"],
  "properties": {
    "schema_version": {"const": 1},
    "template": {"type": "string", "minLength": 1},
    "max_concurrency": {"type": "integer", "minimum": 1},
    "sandbox_timeout_seconds": {"type": "integer", "minimum": 1},
    "bootstrap": {"type": "boolean"},
    "keep_failed_sandboxes": {"type": "boolean"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]},
    "timeout_minutes": {"type": "integer", "minimum": 1},
    "max_cycles": {"type": "integer", "minimum": 1},
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "run_dir", "requirements_file"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "url": {"type": "string", "format": "uri"},
          "run_dir": {"type": "string", "minLength": 1},
          "requirements_file": {"type": "string", "minLength": 1},
          "storage_state": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]},
          "timeout_minutes": {"type": "integer", "minimum": 1},
          "max_cycles": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
