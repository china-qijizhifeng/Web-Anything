{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webanything.dev/schemas/candidate-freeze-v1.schema.json",
  "title": "WebAnything candidate freeze v1",
  "type": "object",
  "required": ["schema", "state", "identity"],
  "properties": {
    "schema": {"const": "webanything-candidate-freeze-v1"},
    "state": {"enum": ["candidate", "frozen", "invalidated"]},
    "identity": {
      "type": "object",
      "required": ["schema", "sha256", "tree", "contracts", "configuration"],
      "properties": {
        "schema": {"const": "webanything-candidate-identity-v1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tree": {"type": "object", "required": ["algorithm", "sha256", "files", "bytes"]},
        "contracts": {"type": "array"},
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sha256"],
            "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
            "additionalProperties": false
          }
        },
        "configuration": {"type": "object"}
      }
    }
  },
  "additionalProperties": false
}
