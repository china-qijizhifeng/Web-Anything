{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webanything.dev/schemas/replay-capture-manifest-v1.schema.json",
  "title": "WebAnything replay capture manifest v1",
  "type": "object",
  "required": ["schema", "source_origin", "external_javascript_execution", "source_auth_persisted", "privacy", "routes", "files"],
  "properties": {
    "schema": {"const": "webanything-replay-capture-manifest-v1"},
    "source_origin": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "allowed_source_origins": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "external_javascript_execution": {"const": false},
    "source_auth_persisted": {"const": false},
    "privacy": {
      "type": "object",
      "required": ["status", "source_credentials_removed", "private_fields_removed", "report_sha256"],
      "properties": {
        "status": {"const": "passed"},
        "source_credentials_removed": {"const": true},
        "private_fields_removed": {"type": "integer", "minimum": 0},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_url", "local_path"],
        "properties": {
          "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "local_path": {"type": "string", "pattern": "^/"}
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^capture/"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"enum": ["dom", "css", "font", "image", "icon", "media", "metadata"]},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
