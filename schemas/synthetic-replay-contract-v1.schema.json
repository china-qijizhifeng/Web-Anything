{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webanything.dev/schemas/synthetic-replay-contract-v1.schema.json",
  "title": "WebAnything full-capture synthetic replay contract v1",
  "type": "object",
  "required": [
    "schema", "schema_version", "build_mode", "seed_url", "site_id", "product_archetype",
    "coverage", "clock", "runtime", "storage", "auth", "routes", "capture_manifest", "visual_reference",
    "tasks", "reset", "evaluator", "network_policy", "content_policy", "concurrency"
  ],
  "properties": {
    "schema": {"const": "webanything-synthetic-replay-contract-v1"},
    "schema_version": {"const": 1},
    "build_mode": {"const": "benchmark_synthetic_replay"},
    "seed_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "site_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "product_archetype": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "required": ["profile", "release_tier", "required_route_kinds", "required_workflows", "generic_fallback_allowed"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "release_tier": {"enum": ["smoke", "product_complete"]},
        "required_route_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "required_workflows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["login", "logout", "reset", "stateful_action", "navigate", "search", "playback", "favorite", "comment", "history", "profile", "add_to_cart", "checkout", "orders", "book", "bookings"]}},
        "generic_fallback_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["fixed_time", "timezone"],
      "properties": {
        "fixed_time": {"type": "string", "format": "date-time"},
        "timezone": {"const": "UTC"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["kind", "entrypoint", "health_path", "proxy_prefix_aware"],
      "properties": {
        "kind": {"const": "flask_sqlite"},
        "entrypoint": {"type": "string", "minLength": 1},
        "health_path": {"type": "string", "pattern": "^/"},
        "proxy_prefix_aware": {"const": true}
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["engine", "seed_path", "seed_sha256", "runtime_path", "reset_mode"],
      "properties": {
        "engine": {"const": "SQLite"},
        "seed_path": {"type": "string", "pattern": "^fixtures/"},
        "seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_path": {"type": "string", "pattern": "^instance/"},
        "reset_mode": {"const": "atomic_seed_replace"}
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["mode", "initial_state", "state_scope", "demo_user_ids", "source_credentials_persisted"],
      "properties": {
        "mode": {"const": "local_synthetic"},
        "initial_state": {"enum": ["explicit_login", "default_authenticated"]},
        "state_scope": {"enum": ["instance", "browser_session"]},
        "demo_user_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "source_credentials_persisted": {"const": false}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "kind", "source", "required_selectors", "required_action_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^route_[a-z0-9_]+$"},
          "path": {"type": "string", "pattern": "^/"},
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "source": {"enum": ["captured", "synthetic", "system"]},
          "required_selectors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_action_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "capture_manifest": {"$ref": "#/$defs/hashedCapture"},
    "visual_reference": {
      "type": "object",
      "required": ["path", "sha256", "reference_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^visual-reference/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "required": ["path", "sha256", "count"],
      "properties": {
        "path": {"const": "tasks.jsonl"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 4}
      },
      "additionalProperties": false
    },
    "reset": {
      "type": "object",
      "required": ["supported", "entrypoint", "endpoint", "method"],
      "properties": {
        "supported": {"const": true},
        "entrypoint": {"type": "string", "pattern": "^/"},
        "endpoint": {"type": "string", "pattern": "^/"},
        "method": {"const": "POST"}
      },
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["endpoint_template", "result_field", "authoritative_surfaces"],
      "properties": {
        "endpoint_template": {"type": "string", "pattern": "^/.*\\{evaluator_id\\}"},
        "result_field": {"const": "passed"},
        "authoritative_surfaces": {"type": "array", "const": ["dom", "url", "SQLite", "network"]}
      },
      "additionalProperties": false
    },
    "network_policy": {
      "type": "object",
      "required": ["external_requests", "allowed_origins", "upstream_javascript_execution"],
      "properties": {
        "external_requests": {"const": 0},
        "allowed_origins": {"type": "array", "maxItems": 0},
        "upstream_javascript_execution": {"const": false}
      },
      "additionalProperties": false
    },
    "content_policy": {
      "type": "object",
      "required": ["mode", "private_user_data_allowed", "source_assets_local_only"],
      "properties": {
        "mode": {"const": "source_fidelity"},
        "private_user_data_allowed": {"const": false},
        "source_assets_local_only": {"const": true}
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "required": ["isolation", "max_parallel_sessions"],
      "properties": {
        "isolation": {"enum": ["isolated_instance", "session_partitioned"]},
        "max_parallel_sessions": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hashedCapture": {
      "type": "object",
      "required": ["path", "sha256", "bundle_sha256", "file_count", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^capture/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
