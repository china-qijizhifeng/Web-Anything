# Copy values into your process environment or an untracked secret manager file.
# Never commit real credentials.
WEBANYTHING_RESPONSES_API_KEY=example-value
WEBANYTHING_RESPONSES_BASE_URL=https://api.openai.com/v1

# Optional environment-only configuration for `webanything create`.
# Set both values instead of running `webanything configure`.
WEBANYTHING_API_KEY=example-value
WEBANYTHING_API_URL=https://api.openai.com/v1

# Optional deployment variables used by the E2B adapter.
E2B_API_KEY=example-value
E2B_API_URL=https://api.e2b.dev
E2B_DOMAIN=e2b.app
